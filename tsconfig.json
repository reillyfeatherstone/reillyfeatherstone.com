{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "src/components/posthog.astro"],
  "compilerOptions": {
    "paths": {
      "@styles/*": ["./src/styles/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@components/*": ["./src/components/*"],
      "@content/*": ["./src/content/*"],
      "@utils/*": ["./src/utils/*"],
      "@data/*": ["./src/data/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  }
}
