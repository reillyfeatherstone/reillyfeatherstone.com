---
import { IconArrowUpRight } from "@tabler/icons-preact"

import BaseLayout from "@layouts/BaseLayout.astro"
import ContactForm from "@components/ContactForm.tsx"

const socials = [
  { label: "IMDb", href: "https://www.imdb.com/name/nm7475358/" },
  { label: "Instagram", href: "https://www.instagram.com/reillyfeatherstone/" },
  { label: "Spotlight", href: "https://www.spotlight.com/5090-7833-5965/" },
]
---

<BaseLayout
  title="Contact"
  description="Get in touch with Welsh actor Reilly Featherstone for casting enquiries, professional bookings and general questions."
>
  <div
    class="mx-auto flex w-full max-w-md flex-col gap-10 px-4 pt-6 md:px-0 md:pt-10"
  >
    <ContactForm client:load />

    <div class="border-t border-card-accent pt-6">
      <ul class="flex flex-wrap justify-center gap-x-8 gap-y-2 text-sm">
        {
          socials.map((social) => (
            <li>
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-1.5 transition-colors hover:text-accent"
              >
                {social.label}
                <IconArrowUpRight
                  size={12}
                  className="text-accent transition-transform group-hover:translate-x-1"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</BaseLayout>
