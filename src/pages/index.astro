---
import { Picture } from "astro:assets"
import BaseLayout from "@layouts/BaseLayout.astro"
import ProjectGrid from "@components/ProjectGrid.astro"
const headshot =
  "https://static.reillyfeatherstone.com/Reilly%20Featherstone%20Headshot.jpg"
import { Content as Bio } from "@content/bio.md"
---

<BaseLayout title="Home">
  <div id="hero" class="flex min-h-[40vh] gap-8 items-center justify-between">
    <div class="grid md:grid-cols-2 gap-8">
      <Picture
        class="rounded-xs md:pt-15"
        src={headshot}
        alt="Reilly Featherstone Actor Headshot"
        quality={"high"}
        formats={["avif", "webp", "jpg"]}
        fallbackFormat="jpg"
        loading="eager"
        inferSize
      />
      <div
        id="about"
        class="bio prose
        prose-h1:no-underline prose-h1:font-medium prose-h1:text-[1.75rem] prose-h1:leading-10
        prose-strong:font-bold prose-strong:text-accent
        prose-a:no-underline prose-a:font-bold prose-a:italic"
      >
        <Bio />
      </div>
    </div>
  </div>
  <div class="pt-30">
    <ProjectGrid maxGrid={2} limit={3} priority={0} featured />
  </div>
</BaseLayout>
