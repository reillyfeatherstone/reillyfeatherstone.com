---
import { formatDateRange } from "@utils/dates"
import ProjectMeta from "@components/ProjectMeta.astro"
import BaseLayout from "@layouts/BaseLayout.astro"
import { Picture } from "astro:assets"
import { render } from "astro:content"
import { getProjects } from "@utils/projects"
import Prose from "@components/Prose.astro"
import ProjectLinks from "@components/ProjectLinks.astro"
import ProjectNav from "@components/ProjectNav.astro"
import { markdownToDescription } from "@utils/markdownToDescription"
import { buildProjectSchema } from "@data/projectSchema"

export async function getStaticPaths() {
  const projects = await getProjects()

  return projects.map((project, i) => {
    const prev = projects[i + 1]
    const next = projects[i - 1]

    return {
      params: { slug: project.id },
      props: {
        project,
        prev: prev && { id: prev.id, title: prev.data.title },
        next: next && { id: next.id, title: next.data.title },
      },
    }
  })
}

const { project, prev, next } = Astro.props
const { startDate, endDate } = project.data

const metadata = [
  { label: "Date", value: formatDateRange(startDate, endDate) },
  { label: "Format", value: project.data.format },
  { label: "Directors", value: project.data.directors },
  { label: "Writers", value: project.data.writers },
  { label: "Production Companies", value: project.data.prodCompanies },
  { label: "Venues", value: project.data.venues },
  { label: "Cast", value: project.data.cast },
  { label: "Partners", value: project.data.partners },
]

const { Content } = await render(project)
const description = markdownToDescription(project.body) || undefined

const schema = buildProjectSchema(project.data, {
  url: new URL(Astro.url.pathname, Astro.site).href,
  description,
  image: project.data.banner || undefined,
})

const rows = [
  ["md:col-span-7", "md:col-span-5"],
  ["md:col-span-5", "md:col-span-7"],
]
const spans = rows.flat()
---

<BaseLayout
  title={project.data.title}
  description={description}
  image={project.data.banner || undefined}
  imageAlt={project.data.title}
  schema={schema}
>
  {
    project.data.banner ? (
      <div class="w-full aspect-585/300 md:aspect-1280/533 overflow-hidden">
        <Picture
          class="block w-full h-full object-cover"
          src={project.data.banner}
          alt={project.data.title}
          quality={"high"}
          formats={["avif", "webp", "jpg"]}
          fallbackFormat="jpg"
          loading="eager"
          inferSize
          priority
          fit="cover"
        />
      </div>
    ) : (
      <div />
    )
  }
  <h1 class="text-5xl uppercase font-bold pt-5 md:text-6xl lg:text-7xl">
    {project.data.title}
  </h1>

  <div class="grid md:grid-cols-[3fr_4fr] lg:grid-cols-[3fr_4fr] gap-10 pb-15">
    <ProjectMeta metadata={metadata} />
    <div class="pt-3 md:pt-0">
      <h2 class="text-xl font-bold pb-2 uppercase mb-0">Synopsis</h2>
      <Prose><Content /></Prose>
      <ProjectLinks links={project.data.links} />
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-12 gap-x-6 gap-y-8 items-start">
    {
      project.data.gallery.map((image, i) => (
        <figure class={spans[i % spans.length]}>
          <Picture
            class="block w-full h-auto rounded-md"
            src={image.url}
            alt={image.alt}
            quality="mid"
            formats={["avif", "webp", "jpg"]}
            fallbackFormat="jpg"
            loading={"lazy"}
            inferSize
          />
          {(image.title || image.label) && (
            <figcaption class="flex justify-between items-start gap-4 pt-2 px-1 text-xs">
              <span class="min-w-0 text-foreground/90">{image.title}</span>
              <span class="shrink-0 whitespace-nowrap text-foreground/50">
                {image.label}
              </span>
            </figcaption>
          )}
        </figure>
      ))
    }
  </div>

  <ProjectNav prev={prev} next={next} />
</BaseLayout>
