---
import { IconMail, IconArrowUpRight, IconPhone } from "@tabler/icons-preact"
---

<footer class="bg-sunken border-t border-foreground/20 pt-10">
  <div class="max-w-270 mx-auto p-5">
    <div>
      <span class="text-3xl font-bold">Contact</span>
    </div>
    <div
      class="grid md:grid-cols-2 pt-6 pb-10 md:gap-5 gap-8 border-b border-foreground/20"
    >
      <div
        class="flex flex-col bg-card border border-card-accent rounded p-5 lg:p-7 gap-2"
      >
        <div class="flex flex-col gap-1 border-b pb-3 border-foreground/10">
          <p class="text-accent text-sm font-bold uppercase">Representation</p>
          <p class="text-lg font-bold">Acting & Professional Enquiries</p>
        </div>
        <div class="flex flex-col pt-2 gap-5 text-lg">
          <a
            href="https://www.nancyhudsonassociates.com/"
            class="flex flex-col gap-1"
            target="_blank"
          >
            <p class="text-md font-bold">Nancy Hudson Associates</p>
            <p class="text-sm">
              <span class="text-muted font-medium">Agent:{" "}</span>Nancy
              Hudson
            </p>
            <p class="text-sm">
              <span class="text-muted font-medium">Assistant Agent:{" "}</span
              >Felicity Coleman
            </p>
          </a>
          <div class="flex flex-col gap-1">
            <div class="flex flex-col gap-2">
              <a
                href="mailto:agents@nancyhudsonassociates.com"
                class="flex items-center gap-2 text-sm group w-fit"
              >
                <IconMail size={18} className="text-accent" />
                <span class="text-xs sm:text-sm"
                  >agents@nancyhudsonassociates.com</span
                >
                <IconArrowUpRight
                  size={12}
                  className="text-accent transition-transform group-hover:translate-x-1"
                />
              </a>

              <a
                href="tel:02074995548"
                class="flex items-center gap-2 text-sm tracking-wide group w-fit"
              >
                <!-- <span class="text-accent text-lg">✆</span> -->
                <IconPhone size={18} className="text-accent" />
                <span class="text-xs sm:text-sm">02074995548</span>
                <IconArrowUpRight
                  size={12}
                  className="text-accent transition-transform group-hover:translate-x-1"
                />
              </a>
            </div>
          </div>
        </div>
      </div>

      <div
        class="flex flex-col bg-card border border-card-accent rounded p-7 gap-2"
      >
        <div class="flex flex-col gap-1 border-b pb-3 border-foreground/10">
          <p class="text-accent text-sm font-bold uppercase">Direct Contact</p>
          <p class="text-lg font-bold">General Enquiries</p>
        </div>

        <div class="flex flex-col pt-2 gap-4">
          <p class="text-sm text-muted leading-relaxed">
            Please note, any work related enquiries should go to my agent.
          </p>

          <a
            href="mailto:enquiries@reillyfeatherstone.com"
            class="flex items-center gap-2 text-sm group w-fit"
          >
            <IconMail size={18} className="text-accent" />
            <span class="text-xs sm:text-sm"
              >enquiries@reillyfeatherstone.com</span
            >
            <IconArrowUpRight
              size={12}
              className="text-accent transition-transform group-hover:translate-x-1"
            />
          </a>
        </div>
      </div>
    </div>
    <div>
      <p class="text-xs text-muted pt-5">
        © 2026 Reilly Featherstone. All rights reserved.
      </p>
    </div>
  </div>
</footer>
