---
import { IconArrowLeft, IconArrowRight } from "@tabler/icons-preact"

interface Link {
  id: string
  title: string
}

interface Props {
  prev?: Link
  next?: Link
}

const { prev, next } = Astro.props
---

<nav
  aria-label="Project navigation"
  class="grid grid-cols-3 items-center gap-4 border-t border-foreground/20 py-8 mt-10 text-sm uppercase"
>
  {
    prev ? (
      <a
        href={`/projects/${prev.id}`}
        rel="prev"
        class="group flex items-center gap-3 justify-self-start"
      >
        <span
          aria-hidden="true"
          class="transition-transform group-hover:-translate-x-1"
        >
          <IconArrowLeft size={16} />
        </span>

        <span class="flex flex-col">
          <span class="font-medium">Previous</span>
          <span class="normal-case text-foreground/70">{prev.title}</span>
        </span>
      </a>
    ) : (
      <span />
    )
  }

  <a
    href="/projects"
    class="justify-self-center font-medium hover:text-foreground/70"
  >
    All projects
  </a>

  {
    next ? (
      <a
        href={`/projects/${next.id}`}
        rel="next"
        class="group flex items-center gap-3 justify-self-end text-right"
      >
        <span class="flex flex-col">
          <span class="font-medium">Next</span>
          <span class="normal-case text-foreground/70">{next.title}</span>
        </span>
        <span
          aria-hidden="true"
          class="transition-transform group-hover:translate-x-1"
        >
          <IconArrowRight size={16} />
        </span>
      </a>
    ) : (
      <span />
    )
  }
</nav>
