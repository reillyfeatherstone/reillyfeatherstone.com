---
const pathname = Astro.url.pathname

const leftLinks = [
  { href: "/", label: "Home" },
  { href: "/#about", label: "About" },
  { href: "/projects", label: "Work" },
  { href: "/now", label: "Now" },
]

const rightLinks = [
  { href: "/press", label: "Press" },
  { href: "/coaching", label: "Coaching" },
  { href: "/contact", label: "Contact" },
]

const allLinks = [...leftLinks, ...rightLinks]
---

<header
  class="relative grid lg:grid-cols-[1fr_auto_1fr] items-center justify-center gap-4 px-10"
>
  <nav
    class="hidden nav-left lg:block lg:justify-self-start xl:justify-self-end"
  >
    <ul class="flex space-x-8">
      {
        leftLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={link.href === pathname ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="flex flex-col items-center px-6 py-4">
    <a
      href="/"
      class="logo flex flex-col items-center font-normal text-3xl md:font-light md:text-5xl md:gap-2 lg:text-5xl lg:gap-4 xl:text-6xl"
    >
      <span class="tracking-wide">REILLY</span>
      <span class="">FEATHERSTONE</span>
    </a>
  </div>

  <nav
    class="hidden nav-left lg:block lg:justify-self-end xl:justify-self-start"
  >
    <ul class="flex space-x-8">
      {
        rightLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={link.href === pathname ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <!-- Mobile menu toggle -->
  <button
    id="mobile-menu-toggle"
    class="absolute right-5 top-1/2 -translate-y-1/2 text-2xl md:hidden"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    ☰
  </button>

  <nav
    id="mobile-menu"
    class="hidden absolute left-0 right-0 top-full z-50 text-secondary bg-primary/35 px-6 py-6 shadow-md md:static md:mt-2 md:flex md:justify-center md:bg-transparent md:px-0 md:py-0 md:shadow-none lg:hidden"
  >
    <ul
      class="flex flex-col gap-5 text-center md:flex-row md:gap-8 md:space-x-0 md:text-xs"
    >
      {
        allLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={link.href === pathname ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector("#mobile-menu-toggle")
  const menu = document.querySelector("#mobile-menu")

  toggle?.addEventListener("click", () => {
    if (!menu) return

    const isOpen = toggle.getAttribute("aria-expanded") === "true"

    toggle.setAttribute("aria-expanded", String(!isOpen))
    toggle.setAttribute("aria-label", isOpen ? "Open menu" : "Close menu")
    toggle.textContent = isOpen ? "☰" : "×"

    menu.classList.toggle("hidden", isOpen)
  })
</script>
