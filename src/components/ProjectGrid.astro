---
import ProjectCard from "@components/ProjectCard.astro"
import { getProjects } from "@utils/projects"

interface Props {
  limit?: number
  priority?: number
  maxGrid?: 1 | 2 | 3
  filterable?: boolean
  featured?: boolean
}

const {
  limit = Infinity,
  maxGrid = 3,
  filterable = false,
  priority = 6,
  featured = false,
} = Astro.props

const allProjects = await getProjects()

const projects = featured
  ? allProjects.filter((p) => p.data.featured)
  : allProjects

const grids = {
  1: "grid-cols-1",
  2: "md:grid-cols-2",
  3: "md:grid-cols-2 lg:grid-cols-3",
} as const

const selectedProjects = projects.slice(0, limit)
// const hasMore = projects.length > selectedProjects.length
// const emptySlots = (maxGrid - (limit % maxGrid)) % maxGrid
// const showViewMore = hasMore && emptySlots > 0

const formats = [...new Set(projects.map((p) => p.data.format))]
---

<div data-project-grid>
  <div class="flex justify-between">
    <h1 class="text-3xl font-bold">
      {featured ? "Featured Projects" : "Projects"}
    </h1>
    {
      filterable && (
        <div
          class="mb-6 flex flex-wrap gap-2"
          role="group"
          aria-label="Filter by format"
        >
          {["All", ...formats].map((format) => (
            <button
              type="button"
              data-filter={format}
              aria-pressed={format === "All"}
              class="rounded-full border border-foreground/40 px-3 text-xs font-medium text-foreground transition-colors hover:border-foreground/60 aria-pressed:border-foreground aria-pressed:bg-foreground aria-pressed:text-background hover:cursor-pointer"
            >
              {format}
            </button>
          ))}
        </div>
      )
    }
  </div>
  <div class:list={["grid gap-8", grids[maxGrid]]}>
    {
      selectedProjects.slice(0, limit).map((project, i) => (
        <div data-format={project.data.format}>
          <ProjectCard project={project} priority={i < priority} />
        </div>
      ))
    }
    {
      featured && (
        <a
          href="/projects"
          class="self-start border-2 border-card-accent aspect-video flex items-center justify-center rounded-md bg-card text-foreground font-semibold hover:bg-card-accent transition-colors"
        >
          View More
        </a>
      )
    }
  </div>
</div>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-project-grid]")
    .forEach((grid) => {
      const buttons = grid.querySelectorAll<HTMLButtonElement>("[data-filter]")
      const items = grid.querySelectorAll<HTMLElement>("[data-format]")

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          const selected = button.dataset.filter

          buttons.forEach((b) =>
            b.setAttribute("aria-pressed", String(b === button)),
          )

          items.forEach((item) => {
            item.hidden = selected !== "All" && item.dataset.format !== selected
          })
        })
      })
    })
</script>
